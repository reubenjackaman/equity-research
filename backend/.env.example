# Copy this file to ".env" and fill in your values.
# .env is listed in .gitignore, so your keys never get committed.

# Finnhub: free key from https://finnhub.io/register (used from Phase 4 for news)
FINNHUB_API_KEY=

# SEC EDGAR asks every app to identify itself with a name and email (no key needed).
# Used from Phase 2 for 5+ years of US financial statements.
SEC_USER_AGENT="Equity Research Student App your.email@example.com"

# Google Gemini: free key from https://aistudio.google.com (powers "Ask Finch"). Leave blank to turn it off.
GEMINI_API_KEY=
